# ── Application ───────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=HRMF
APP_VERSION=0.1.0
APP_TIMEZONE=Asia/Kolkata

# ── Database (Neon) ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Object Storage (S3-compatible) ───────────────────────────────────
STORAGE_BUCKET=hrmf-uploads
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_ENDPOINT=https://s3.amazonaws.com

# ── SMTP / Email ─────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=HRMF

# ── Internal / Cron ──────────────────────────────────────────────────
INTERNAL_API_TOKEN=change-me-internal-token
CRON_SECRET=change-me-cron-secret

# ── Dev Seed Admin ───────────────────────────────────────────────────
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=change-me-admin-password
