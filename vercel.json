{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,.venv/**,node_modules/**,.agents/**,.git/**,**/*.md}"
    }
  },
  "crons": [
    {
      "path": "/internal/jobs/drain",
      "schedule": "0 12 * * *"
    }
  ]
}
